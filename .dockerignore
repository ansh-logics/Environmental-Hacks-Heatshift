# Build artefacts and dependencies are re-created inside the image.
**/node_modules
**/dist
**/dev-dist
**/*.tsbuildinfo
**/coverage

# Local environment and tooling
.git
.github
.env
.env.*
!.env.example
.vscode
.idea
.DS_Store
*.log
logs

