# ---------- API (apps/api) ----------
# Node runtime + Fastify. Values below are safe local defaults; never commit a real .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-free single origin allowed to call the API from a browser
CORS_ORIGIN=http://localhost:5173

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=heatshift
POSTGRES_PASSWORD=heatshift
POSTGRES_DB=heatshift

# Full connection string used by the API. Inside docker-compose the host is the service name "postgres".
DATABASE_URL=postgres://heatshift:heatshift@localhost:5432/heatshift

# Boot-time database behaviour (used by the API Docker image entrypoint).
MIGRATE_ON_BOOT=true
SEED_ON_BOOT=true

# ---------- Web (apps/web) ----------
# Read at build time by Vite; baked into the JS bundle.
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_NAME=HeatShift

# Public Mapbox token (starts with "pk.") for the relief map.
# Create one at https://account.mapbox.com/access-tokens/. Vite loads it from the
# repo-root .env during `pnpm dev`, and docker compose forwards it to the web
# image as a build arg for the production bundle. It is browser-visible by
# design, so restrict it in your Mapbox account with URL authorisation.
#
# Leave it empty to run without a map: the relief list still works and the map
# area shows a "Map unavailable in this environment" fallback.
VITE_MAPBOX_ACCESS_TOKEN=

# ---------- Later / not used yet ----------
# Live weather uses Open-Meteo, which needs no API key, so this stays unset.
WEATHER_PROVIDER_API_KEY=
# S3 bucket for uploaded images (later phase).
S3_IMAGE_BUCKET=
