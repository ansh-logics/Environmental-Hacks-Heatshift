{
  "name": "@heatshift/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas, inferred types and domain constants shared by the HeatShift API and web app",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --target es2022 --out-dir dist --clean",
    "dev": "tsup src/index.ts --format esm --dts --target es2022 --out-dir dist --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
